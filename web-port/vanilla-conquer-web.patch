diff --git a/common/webyield.h b/common/webyield.h
new file mode 100644
index 0000000..b24d7f9
--- /dev/null
+++ b/common/webyield.h
@@ -0,0 +1,43 @@
+// Browser (Emscripten) build support.
+//
+// The original game code runs its own blocking loops (menus, scenario load,
+// the main game loop) and never returns control to the caller. In a browser
+// the page can only repaint and deliver input when JavaScript returns to the
+// event loop, so with ASYNCIFY we periodically unwind back to the browser.
+//
+// This file is part of a GPL v3 derivative of the EA Command & Conquer source.
+
+#ifndef WEBYIELD_H
+#define WEBYIELD_H
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten.h>
+
+/**
+ * Give the browser a chance to run (paint, input, audio) if we have been
+ * running for more than a few milliseconds without doing so. Cheap to call
+ * from hot paths such as timer reads and input polls.
+ */
+extern bool Web_Yield_Enabled;
+
+static inline void Web_Yield(bool force = false)
+{
+    // Never unwind before main() runs: static constructors read the timer too
+    // and asyncify cannot suspend inside __wasm_call_ctors.
+    if (!Web_Yield_Enabled) {
+        return;
+    }
+    static double last_yield = 0.0;
+    double now = emscripten_get_now();
+    if (force || now - last_yield > 8.0) {
+        emscripten_sleep(0);
+        last_yield = emscripten_get_now();
+    }
+}
+#else
+static inline void Web_Yield(bool = false)
+{
+}
+#endif
+
+#endif // WEBYIELD_H
