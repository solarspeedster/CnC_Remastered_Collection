diff --git a/web/build.sh b/web/build.sh
new file mode 100755
index 0000000..f91579b
--- /dev/null
+++ b/web/build.sh
@@ -0,0 +1,10 @@
+#!/usr/bin/env bash
+# Build the browser (WebAssembly) version of Vanilla TD.
+# Needs an activated emsdk (https://emscripten.org). Output: build-web/vanillatd.{html,js,wasm}
+# Serve build-web/ over http(s) and open vanillatd.html in Chrome. No game data is included;
+# the page asks the player for their own original data files and keeps them in IndexedDB.
+set -euo pipefail
+cd "$(dirname "$0")/.."
+emcmake cmake -B build-web -G Ninja -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_VANILLARA=OFF -DNETWORKING=OFF "$@"
+cmake --build build-web --target VanillaTD
diff --git a/web/shell.html b/web/shell.html
new file mode 100644
index 0000000..d27fec2
--- /dev/null
+++ b/web/shell.html
@@ -0,0 +1,136 @@
+<!doctype html>
+<html lang="en">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Vanilla Conquer (browser build)</title>
+<style>
+  html, body { margin: 0; height: 100%; background: #000; color: #ddd; font: 15px/1.4 system-ui, sans-serif; }
+  /* SDL sets an inline size; scale the canvas to fit the window, keeping 16:10. */
+  #canvas { display: block; margin: 0 auto; width: min(100vw, calc(100vh * 1.6)) !important; height: auto !important; outline: none; }
+  #setup { max-width: 560px; margin: 10vh auto; padding: 24px; background: #1b1b1b; border: 1px solid #333; border-radius: 8px; }
+  #setup h1 { font-size: 20px; margin: 0 0 12px; }
+  #setup code { background: #333; padding: 1px 4px; border-radius: 3px; }
+  #setup button, #setup label.btn { display: inline-block; margin: 12px 8px 0 0; padding: 8px 14px; background: #3a6; color: #fff; border: 0; border-radius: 4px; cursor: pointer; font: inherit; }
+  #setup input[type=file] { display: none; }
+  #status { margin-top: 12px; color: #aaa; white-space: pre-wrap; }
+  .hidden { display: none !important; }
+</style>
+</head>
+<body>
+<div id="setup" class="hidden">
+  <h1>Load your game files</h1>
+  <p>This build ships no game data. Pick the folder that holds your own copy of the original
+  Tiberian Dawn data files (for example <code>CONQUER.MIX</code>, <code>GENERAL.MIX</code>,
+  <code>DESERT.MIX</code>, <code>TEMPERAT.MIX</code>, <code>WINTER.MIX</code>, <code>SOUNDS.MIX</code>,
+  <code>SPEECH.MIX</code>, <code>LOCAL.MIX</code>, <code>UPDATE.MIX</code>, <code>UPDATEC.MIX</code>, <code>TRANSIT.MIX</code>).</p>
+  <p>The files stay in this browser (IndexedDB). Nothing is uploaded.</p>
+  <label class="btn">Choose folder<input id="pickdir" type="file" webkitdirectory multiple></label>
+  <label class="btn">Choose files<input id="pickfiles" type="file" multiple></label>
+  <button id="play" class="hidden">Play</button>
+  <button id="forget" class="hidden">Forget stored files</button>
+  <div id="status"></div>
+</div>
+<canvas id="canvas" tabindex="-1" oncontextmenu="event.preventDefault()"></canvas>
+<script>
+  const DATA_DIR = '/data';
+  const setupEl = document.getElementById('setup');
+  const statusEl = document.getElementById('status');
+  const canvas = document.getElementById("canvas");
+
+  function syncfs(populate) {
+    return new Promise((resolve, reject) => FS.syncfs(populate, err => err ? reject(err) : resolve()));
+  }
+
+  function haveData() {
+    try { return FS.readdir(DATA_DIR).some(n => n.toUpperCase() === 'CONQUER.MIX'); } catch (e) { return false; }
+  }
+
+  function waitForFiles() {
+    return new Promise(resolve => {
+      setupEl.classList.remove('hidden');
+      canvas.classList.add('hidden');
+      async function onPick(ev) {
+        const files = Array.from(ev.target.files);
+        let n = 0;
+        for (const f of files) {
+          const name = f.name.toUpperCase();
+          if (!/\.(MIX|INI|AUD|VQA|VQP|PAL|SHP|CPS|ENG|BIN)$/.test(name)) continue;
+          statusEl.textContent = 'Copying ' + name + ' ...';
+          const buf = new Uint8Array(await f.arrayBuffer());
+          FS.writeFile(DATA_DIR + '/' + name, buf);
+          n++;
+        }
+        if (!haveData()) {
+          statusEl.textContent = 'Copied ' + n + ' files, but CONQUER.MIX was not among them. Try again with the folder that contains it.';
+          return;
+        }
+        statusEl.textContent = 'Saving ' + n + ' files in this browser ...';
+        await syncfs(false);
+        setupEl.classList.add('hidden');
+        canvas.classList.remove('hidden');
+        canvas.focus();
+        resolve();
+      }
+      document.getElementById('pickdir').onchange = onPick;
+      document.getElementById('pickfiles').onchange = onPick;
+    });
+  }
+
+  document.getElementById('forget').onclick = async () => {
+    for (const n of FS.readdir(DATA_DIR)) { if (n !== '.' && n !== '..') FS.unlink(DATA_DIR + '/' + n); }
+    await syncfs(false);
+    location.reload();
+  };
+
+  // Browsers only allow audio after a user gesture, so start on a click.
+  function waitForClick() {
+    return new Promise(resolve => {
+      setupEl.classList.remove('hidden');
+      canvas.classList.add('hidden');
+      setupEl.querySelector('h1').textContent = 'Ready';
+      setupEl.querySelectorAll('p, label.btn').forEach(e => e.classList.add('hidden'));
+      const play = document.getElementById('play');
+      play.classList.remove('hidden');
+      document.getElementById('forget').classList.remove('hidden');
+      play.onclick = () => {
+        setupEl.classList.add('hidden');
+        canvas.classList.remove('hidden');
+        canvas.focus();
+        resolve();
+      };
+    });
+  }
+
+  var Module = {
+    canvas: canvas,
+    print: (t) => console.log(t),
+    printErr: (t) => console.warn(t),
+    preRun: [function () {
+      FS.mkdir(DATA_DIR);
+      FS.mount(IDBFS, {}, DATA_DIR);
+      FS.mkdirTree('/home/web_user/.config/vanilla-conquer');
+      FS.mount(IDBFS, {}, '/home/web_user/.config/vanilla-conquer');
+      addRunDependency('game-data');
+      syncfs(true)
+        .then(() => haveData() ? waitForClick() : waitForFiles())
+        .then(() => removeRunDependency('game-data'))
+        .catch(e => { statusEl.textContent = 'Storage error: ' + e; });
+    }],
+    // Persist settings and saved games, and explain an early exit.
+    onExit: (code) => {
+      FS.syncfs(false, () => {});
+      canvas.classList.add('hidden');
+      setupEl.classList.remove('hidden');
+      setupEl.querySelector('h1').textContent = 'The game stopped (exit code ' + code + ')';
+      statusEl.textContent = code ? 'If this happened right away, some game files are probably missing. ' +
+        'Use "Forget stored files" and pick the folder again.' : '';
+      document.getElementById('forget').classList.remove('hidden');
+    },
+  };
+  window.addEventListener('beforeunload', () => { try { FS.syncfs(false, () => {}); } catch (e) {} });
+  setInterval(() => { try { FS.syncfs(false, () => {}); } catch (e) {} }, 10000);
+</script>
+{{{ SCRIPT }}}
+</body>
+</html>
